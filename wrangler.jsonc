{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fullworks-google-sheets-sync",
	"main": "src/index.js",
	"compatibility_date": "2026-08-26",
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": [
			"0 * * * *"
		]
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
}