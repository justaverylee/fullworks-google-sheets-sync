{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fullworks-google-sheets-sync",
	"main": "src/index.js",
	"compatibility_date": "2026-08-26",
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": [
			"0 * * * *"
		]
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"secrets_store_secrets": [
		{
			"binding": "googleserviceaccount",
			"store_id": "3d5a953b43d04149827e03bbb5d15d70",
			"secret_name": "google_sheets_service_account"
		},
		{
			"binding": "fullworkslogin",
			"store_id": "3d5a953b43d04149827e03bbb5d15d70",
			"secret_name": "fullworks_login"
		}
	],
}